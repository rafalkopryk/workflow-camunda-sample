{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Elsa": "Information"
    }
  },
  "AllowedHosts": "*",
  "Studio": {
    "HostingModel": "Wasm"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/elsa.sqlite.db;Cache=Shared",
    "SqlServer": "Server=localhost;Database=Elsa;Integrated Security=true;TrustServerCertificate=true",
    "PostgreSql": "Host=localhost;Database=elsa;Username=postgres;Password=secret",
    "Oracle": "User Id=elsa;Password=secret;Data Source=//localhost:1521/ORCLPDB1"
  },
  "Http": {
    "BaseUrl": "https://localhost:5001",
    "BasePath": "/workflows",
    "ApiRoutePrefix": "elsa/api"
  },
  "CShells": {
    "Shells": {
      "Default": {
        "Configuration": {
          "WebRouting": {
            "Path": ""
          }
        },
        "Features": {
          "ShellsApi": {},
          "FastEndpoints": {
            "GlobalRoutePrefix": "elsa/api"
          },
          "SqliteWorkflowPersistence": {
            "ConnectionString": "Data Source=App_Data/elsa.sqlite.db;Cache=Shared"
          },
          "Http": {
            "HttpActivityOptions": {
              "BaseUrl": "https://localhost:5001"
            }
          }
        }
      }
    }
  },
  "Shell": {
    "DisableAuthorization": true
  },
  "Backend": {
    "Url": "https://localhost:5001/elsa/api"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [
      "en-US"
    ]
  }
}
